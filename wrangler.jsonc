{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "btcx",
  "main": "worker/dist/worker.js",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./docs",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hyrule-github",
      "database_id": "06a4296d-76ad-40ee-9ce1-6afcd54bf108",
      "migrations_dir": "worker/migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
